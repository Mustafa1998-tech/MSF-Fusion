{
  "name": "@msf/dev",
  "version": "0.1.0",
  "description": "MSF Fusion dev tooling: compile/check CLI for the supported JSX subset and framework diagnostics.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mustafa1998-tech/MSF-Fusion.git",
    "directory": "packages/dev"
  },
  "homepage": "https://github.com/Mustafa1998-tech/MSF-Fusion",
  "bugs": "https://github.com/Mustafa1998-tech/MSF-Fusion/issues",
  "author": "MSF Fusion (Mustafa AI Software Factory)",
  "keywords": ["msf", "msf-fusion", "cli", "devtools", "diagnostics"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "msf-dev": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev:status": "node src/cli.ts status",
    "check": "node dist/cli.js check",
    "compile": "node dist/cli.js compile"
  },
  "dependencies": {
    "@msf/compiler": "workspace:*",
    "@msf/contracts": "workspace:*",
    "@msf/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
