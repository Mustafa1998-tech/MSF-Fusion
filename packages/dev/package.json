{
  "name": "@msf/dev",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "MSF Fusion dev tooling preview (compile APIs/CLI).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "bin": {
    "msf-dev": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev:status": "node src/cli.ts status",
    "check": "node dist/cli.js check",
    "compile": "node dist/cli.js compile"
  },
  "dependencies": {
    "@msf/compiler": "workspace:*",
    "@msf/contracts": "workspace:*",
    "@msf/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

