{
  "name": "@msf/runtime",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "MSF Fusion reactive runtime kernel (Milestone 1).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./universal": {
      "types": "./dist/universal.d.ts",
      "default": "./dist/universal.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@msf/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

