{
  "name": "@mustafa-26112026/runtime",
  "version": "0.1.0",
  "description": "MSF Fusion reactive runtime: fine-grained signals/memos/effects, DOM bindings, SSR renderer, isomorphic mount/hydrate.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mustafa1998-tech/MSF-Fusion.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/Mustafa1998-tech/MSF-Fusion",
  "bugs": "https://github.com/Mustafa1998-tech/MSF-Fusion/issues",
  "author": "MSF Fusion (Mustafa AI Software Factory)",
  "keywords": ["msf", "msf-fusion", "reactive", "fine-grained-reactivity", "ssr", "hydration", "typescript"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./universal": {
      "types": "./dist/universal.d.ts",
      "default": "./dist/universal.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mustafa-26112026/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
