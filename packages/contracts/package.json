{
  "name": "@msf/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Shared contracts and internal interfaces for MSF Fusion packages.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
